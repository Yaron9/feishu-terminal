FEISHU_APP_ID=cli_REPLACE
FEISHU_APP_SECRET=REPLACE
# Optional caller/systemd override; otherwise ~/.config/feishu-terminal/config.json:
# FEISHU_TERMINAL_CONFIG=/absolute/path/to/config.json
# herdr-core: HC_TERMINAL_SOCKET takes precedence over HC_SOCKET_PATH.
# Default: ${XDG_RUNTIME_DIR:-/run/user/<uid>}/herdr-core/default.sock
# HC_SOCKET_PATH=/absolute/path/to/herdr-core/default.sock
# Legacy herdr default: ~/.config/herdr/herdr.sock
# HERDR_SOCKET_PATH=/home/you/.config/herdr/herdr.sock
# Test-only loopback tunnel; takes precedence over socket path:
# HERDR_TCP=127.0.0.1:49450
